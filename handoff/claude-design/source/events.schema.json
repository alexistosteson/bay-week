{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/bay-week/events.schema.json",
  "title": "Bay Week event set",
  "type": "object",
  "required": ["meta", "events"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["window_start", "window_end", "compiled", "origin", "geos", "vocab"],
      "properties": {
        "window_start": { "type": "string", "format": "date" },
        "window_end":   { "type": "string", "format": "date" },
        "compiled":     { "type": "string", "format": "date" },
        "origin": {
          "type": "object",
          "required": ["label", "lat", "lng"],
          "properties": {
            "label": { "type": "string" },
            "lat":   { "type": "number", "minimum": -90,  "maximum": 90 },
            "lng":   { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "geos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "rank"],
            "properties": {
              "id":    { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "label": { "type": "string" },
              "rank":  { "type": "integer", "minimum": 1 },
              "blurb": { "type": "string" },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
            }
          }
        },
        "vocab": {
          "type": "object",
          "required": ["type", "venue_type", "cost"],
          "properties": {
            "type":       { "type": "array", "items": { "type": "string" } },
            "venue_type": { "type": "array", "items": { "type": "string" } },
            "cost":       { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "title", "venue", "city", "geo", "type", "venue_type", "cost"],
        "additionalProperties": false,
        "properties": {
          "id":         { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "date":       { "type": "string", "format": "date" },
          "start":      { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "end":        { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "title":      { "type": "string", "minLength": 2 },
          "venue":      { "type": "string" },
          "city":       { "type": "string" },
          "geo":        { "type": "string" },
          "lat":        { "type": "number" },
          "lng":        { "type": "number" },
          "type":       { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "venue_type": { "type": "string" },
          "genre":      { "type": "array", "items": { "type": "string" } },
          "cost":       { "type": "string" },
          "price":      { "type": "string" },
          "outdoor":    { "type": "boolean" },
          "featured":   { "type": "boolean" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "url":        { "type": "string", "format": "uri" },
          "note":       { "type": "string", "maxLength": 400 }
        }
      }
    }
  }
}
